{
  "name": "nationalproducers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "check-templates": "node scripts/check-templates.mjs",
    "type-check": "vue-tsc --build && node scripts/check-templates.mjs",
    "format": "oxfmt src/",
    "verify:torus": "node --import ./scripts/ts-register.mjs scripts/verify-torus.ts",
    "verify:path": "node --import ./scripts/ts-register.mjs scripts/verify-path.ts",
    "verify:regions": "node --import ./scripts/ts-register.mjs scripts/verify-regions.ts",
    "verify:noise": "node --import ./scripts/ts-register.mjs scripts/verify-noise.ts",
    "verify:fields": "node --import ./scripts/ts-register.mjs scripts/verify-fields.ts",
    "verify:hydrology": "node --import ./scripts/ts-register.mjs scripts/verify-hydrology.ts",
    "verify:settlement": "node --import ./scripts/ts-register.mjs scripts/verify-settlement.ts",
    "verify:pipeline": "node --import ./scripts/ts-register.mjs scripts/verify-pipeline.ts",
    "verify:dualgrid": "node --import ./scripts/ts-register.mjs scripts/verify-dualgrid.ts",
    "verify:rendering": "node --import ./scripts/ts-register.mjs scripts/verify-world-rendering.ts",
    "verify:village": "node --import ./scripts/ts-register.mjs scripts/verify-village.ts",
    "verify:reference": "node --import ./scripts/ts-register.mjs scripts/verify-reference.ts",
    "verify:corrections": "node --import ./scripts/ts-register.mjs scripts/verify-corrections.ts",
    "verify:day-night": "node --import ./scripts/ts-register.mjs scripts/verify-day-night.ts",
    "verify:object-lighting": "node --import ./scripts/ts-register.mjs scripts/verify-object-lighting.ts",
    "verify": "run-s verify:torus verify:path verify:regions verify:noise verify:fields verify:hydrology verify:settlement verify:pipeline verify:dualgrid verify:rendering verify:village verify:reference verify:corrections verify:day-night verify:object-lighting",
    "world:style": "node scripts/worldgen/style.mjs",
    "preview:world": "node --import ./scripts/ts-register.mjs scripts/preview-world.ts",
    "world:gen": "node scripts/worldgen/generate.mjs",
    "world:slice": "node scripts/worldgen/slice.mjs",
    "world:qa": "node scripts/worldgen/qa.mjs",
    "world:test": "node scripts/worldgen/selftest.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "dompurify": "^3.4.15",
    "idb": "^8.0.3",
    "jsqr": "^1.4.0",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^15.0.1",
    "pinia": "^4.0.2",
    "qrcode-generator": "^2.0.4",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.59.0",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
